// Arknights Cost Bar Ruler — first-run configuration wizard.
// Replaces the native Win32 target selector. Cold / sharp / minimal, rendered by
// the software renderer into a per-pixel-alpha layered window. A custom title
// strip provides drag + close (no OS chrome). All user-facing strings are
// localized in Rust and pushed in as properties.
//
// Fixed logical size — mirror WIZARD_LOGICAL_W / WIZARD_LOGICAL_H in
// config_wizard.rs so the native window matches.

import { Palette, Icons, IconBtn } from "theme.slint";

export struct TargetRow {
    name: string,
    detail: string,
    latency: string,       // "12.3 ms", "measuring...", or an error message
    latency-class: int,    // 0 pale-green 1 green 2 yellow 3 orange 4 red 5 unknown
    error: bool,
    selected: bool,
}

export component Wizard inherits Window {
    // ---- inputs ----
    in property <[TargetRow]> rows;
    in property <string> title-text;
    in property <string> header-text;
    in property <string> status-text;
    in property <bool> status-error;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> scanning;          // true while a refresh is in flight / list empty
    in property <string> cap-preview;
    in property <string> cap-empty;       // scanning / no-targets placeholder
    in property <string> cap-auto;
    in property <string> cap-refresh;
    in property <string> cap-start;
    in property <string> cap-cancel;
    in property <string> preview-placeholder;
    in property <string> cap-telemetry;
    in property <string> cap-telemetry-hint;
    in property <bool> update-available: false;
    in property <string> update-text: "";

    // adb-unavailability banner: shown when neither PATH adb nor a bundled
    // emulator adb could be launched. Set by the Rust side via
    // `wizard.set_adb_unavailable(...)` after `adb_resolver::resolve_adb_with`.
    in property <bool> adb-unavailable;
    in property <string> adb-unavailable-message;
    in property <string> adb-unavailable-hint;

    in-out property <bool> auto-checked;
    in-out property <bool> telemetry-checked;

    // debug-related state
    in-out property <bool> debug-expanded;
    in-out property <bool> record-video;
    in-out property <bool> record-csv;
    in-out property <bool> trace-logging;
    in property <string> cap-debug-header;
    in property <string> cap-debug-show;
    in property <string> cap-debug-hide;
    in property <string> cap-debug-video;
    in property <string> cap-debug-csv;
    in property <string> cap-debug-trace;

    // manual target selection (debug-only). The trailing "manual" list row
    // reveals a small panel that builds a target from a typed type + params,
    // replacing the old real/replay capture-mode toggle.
    in property <bool> show-manual-row;
    in-out property <bool> manual-selected;
    in-out property <int> manual-kind;          // 0 MuMu 1 LDPlayer 2 Adb 3 Windows 4 Replay
    in-out property <bool> manual-kind-open;     // dropdown expanded (Slint-only state)
    in-out property <string> manual-install-path;
    in-out property <string> manual-instance-index;
    in-out property <string> manual-device-id;
    in-out property <string> manual-window-title;
    in-out property <string> replay-path;        // reused by the Virtual manual kind
    in-out property <string> replay-fps-text;
    in property <string> cap-manual-row;
    in property <string> cap-manual-header;
    in property <string> cap-manual-type;
    in property <string> cap-manual-type-mumu;
    in property <string> cap-manual-type-ldplayer;
    in property <string> cap-manual-type-adb;
    in property <string> cap-manual-type-pc;
    in property <string> cap-manual-type-virtual;
    in property <string> cap-manual-install;
    in property <string> cap-manual-instance;
    in property <string> cap-manual-serial;
    in property <string> cap-manual-window;
    in property <string> cap-manual-browse;
    in property <string> cap-replay-path;
    in property <string> cap-replay-fps-label;

    // ---- outputs ----
    callback select-target(int);
    callback select-manual();
    callback browse-install();
    callback browse-replay();
    callback refresh();
    callback confirm();
    callback cancel();
    callback close();
    callback open-update();
    callback title-pressed();
    callback title-released();

    background: transparent;
    default-font-family: "Bender";

    // Map a latency class to its badge color.
    function latency-color(cls: int) -> color {
        return cls == 0 ? #69d6a0
            : cls == 1 ? #36d05a
            : cls == 2 ? #ffd23f
            : cls == 3 ? #ff9d3f
            : cls == 4 ? #ff6b5e
            : Palette.text-faint;
    }

    // Label for the manual target-type dropdown (closed field + selected row).
    function manual-type-label(k: int) -> string {
        return k == 0 ? root.cap-manual-type-mumu
            : k == 1 ? root.cap-manual-type-ldplayer
            : k == 2 ? root.cap-manual-type-adb
            : k == 3 ? root.cap-manual-type-pc
            : root.cap-manual-type-virtual;
    }

    // ---- panel + top accent ----
    Rectangle {
        background: #0b1016f8;
        border-width: 1px;
        border-color: Palette.hairline;
    }
    Rectangle {
        x: 0; y: 0;
        width: 100%;
        height: 2px;
        background: Palette.accent;
        opacity: 0.9;
    }

    VerticalLayout {
        padding: 14px;
        padding-top: 10px;
        spacing: 10px;

        // ===== title strip (drag + close) =====
        Rectangle {
            height: 26px;
            drag := TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) { root.title-pressed(); }
                    if (ev.kind == PointerEventKind.up) { root.title-released(); }
                }
            }
            HorizontalLayout {
                Text {
                    text: root.title-text;
                    color: Palette.text-primary;
                    font-size: 15px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if (root.update-available): Rectangle {
                    width: 96px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-width: 1px;
                    border-color: Palette.accent;
                    background: upa.has-hover ? Palette.accent.with-alpha(0.30) : Palette.accent-dim;
                    animate background { duration: 110ms; }
                    Text {
                        text: root.update-text;
                        color: Palette.text-primary;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    upa := TouchArea {
                        clicked => { root.open-update(); }
                    }
                }
                IconBtn {
                    icon: Icons.cross;
                    glyph: 15px;
                    clicked => { root.close(); }
                }
            }
        }

        // ===== header description =====
        Text {
            text: root.header-text;
            color: Palette.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            horizontal-alignment: left;
        }

        // ===== adb unavailable banner =====
        if (root.adb-unavailable): Rectangle {
            border-width: 1px;
            border-color: Palette.danger;
            background: #2a0d0d;
            height: 56px;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    text: root.adb-unavailable-message;
                    color: Palette.danger;
                    font-size: 11px;
                    font-weight: 700;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
                Text {
                    text: root.adb-unavailable-hint;
                    color: Palette.text-faint;
                    font-size: 10px;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
            }
        }

        // ===== body: target list (left) + live preview (right) =====
        HorizontalLayout {
            spacing: 12px;
            height: 168px;

            // ---- target list ----
            Rectangle {
                horizontal-stretch: 1;
                border-width: 1px;
                border-color: Palette.hairline-faint;
                background: #00000040;
                clip: true;

                // empty / scanning placeholder
                if (root.rows.length == 0 && !root.show-manual-row): Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: 100%;
                    text: root.cap-empty;
                    color: Palette.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                list-flick := Flickable {
                    // Many emulator instances (MuMu / LDPlayer) plus Windows and
                    // ADB targets can be discovered at once. The viewport height
                    // tracks the rows' intrinsic height (fixed 38px rows), so the
                    // list flicks/wheels instead of clipping the trailing entries.
                    viewport-width: self.width;
                    viewport-height: rows-col.preferred-height;
                    rows-col := VerticalLayout {
                        padding: 3px;
                        spacing: 1px;
                        alignment: start;
                        for row[idx] in root.rows: Rectangle {
                            height: 38px;
                            background: row.selected ? Palette.accent-dim
                                : (rta.has-hover ? Palette.hover-fill : transparent);
                            animate background { duration: 90ms; }
                            rta := TouchArea {
                                clicked => { root.select-target(idx); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                // selection dot
                                Rectangle {
                                    width: 8px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 3px;
                                        background: row.selected ? Palette.accent : transparent;
                                    }
                                }
                                // name + detail (two stacked lines)
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: row.name;
                                        color: row.error ? Palette.danger : Palette.text-primary;
                                        font-size: 13px;
                                        font-weight: row.selected ? 700 : 500;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.detail;
                                        color: Palette.text-faint;
                                        font-size: 9px;
                                        overflow: elide;
                                    }
                                }
                                // latency badge
                                Text {
                                    text: row.latency;
                                    color: row.error ? Palette.danger : root.latency-color(row.latency-class);
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }

                        // trailing "manual select" row (debug-only). Lives in the
                        // list so it scrolls with the candidates, but is not part of
                        // `root.rows`, so candidate indices stay 1:1 with the model.
                        if (root.show-manual-row): Rectangle {
                            height: 38px;
                            background: root.manual-selected ? Palette.accent-dim
                                : (mta.has-hover ? Palette.hover-fill : transparent);
                            animate background { duration: 90ms; }
                            mta := TouchArea {
                                clicked => { root.select-manual(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                // plus glyph in the selection-dot column
                                Rectangle {
                                    width: 8px;
                                    Path {
                                        width: 12px;
                                        height: 12px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-x: 0;
                                        viewbox-y: -960;
                                        viewbox-width: 960;
                                        viewbox-height: 960;
                                        commands: Icons.plus;
                                        fill: root.manual-selected ? Palette.accent : Palette.text-secondary;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.cap-manual-row;
                                    color: Palette.text-primary;
                                    font-size: 13px;
                                    font-weight: root.manual-selected ? 700 : 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Scroll indicator: visible only when the rows overflow the
                // viewport. Passive — the mouse wheel (WM_MOUSEWHEEL in
                // config_wizard) and drag-pan do the actual scrolling.
                if (list-flick.viewport-height > list-flick.height): Rectangle {
                    x: parent.width - self.width - 2px;
                    y: 2px;
                    width: 3px;
                    height: parent.height - 4px;
                    background: #ffffff12;
                    Rectangle {
                        x: 0;
                        width: parent.width;
                        border-radius: 1.5px;
                        background: Palette.accent;
                        opacity: 0.55;
                        height: max(18px, parent.height * list-flick.height / list-flick.viewport-height);
                        y: (parent.height - self.height)
                            * (-list-flick.viewport-y / (list-flick.viewport-height - list-flick.height));
                    }
                }
            }

            // ---- live preview ----
            VerticalLayout {
                width: 224px;
                spacing: 5px;
                Text {
                    text: root.cap-preview;
                    color: Palette.text-faint;
                    font-size: 10px;
                    letter-spacing: 1px;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Palette.hairline-faint;
                    background: #000000;
                    clip: true;
                    if (root.has-preview): Image {
                        width: 100%;
                        height: 100%;
                        source: root.preview;
                        image-fit: contain;
                    }
                    if (!root.has-preview): Text {
                        width: 100%;
                        height: 100%;
                        text: root.preview-placeholder;
                        color: Palette.text-faint;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ===== auto-select toggle =====
        VerticalLayout {
            spacing: 5px;

            Rectangle {
                height: 20px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    check := Rectangle {
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-width: 1px;
                        border-color: root.auto-checked ? Palette.accent : Palette.hairline-faint;
                        background: root.auto-checked ? Palette.accent-dim : transparent;
                        animate background, border-color { duration: 110ms; }
                        if (root.auto-checked): Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-x: 0;
                            viewbox-y: -960;
                            viewbox-width: 960;
                            viewbox-height: 960;
                            commands: Icons.check;
                            fill: Palette.text-primary;
                        }
                        cta := TouchArea {
                            clicked => { root.auto-checked = !root.auto-checked; }
                        }
                    }
                    Text {
                        text: root.cap-auto;
                        color: Palette.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 36px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: 1px;
                        border-width: 1px;
                        border-color: root.telemetry-checked ? Palette.accent : Palette.hairline-faint;
                        background: root.telemetry-checked ? Palette.accent-dim : transparent;
                        animate background, border-color { duration: 110ms; }
                        if (root.telemetry-checked): Path {
                            width: 14px;
                            height: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-x: 0;
                            viewbox-y: -960;
                            viewbox-width: 960;
                            viewbox-height: 960;
                            commands: Icons.check;
                            fill: Palette.text-primary;
                        }
                        tta := TouchArea {
                            clicked => { root.telemetry-checked = !root.telemetry-checked; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        Text {
                            text: root.cap-telemetry;
                            color: Palette.text-secondary;
                            font-size: 11px;
                        }
                        Text {
                            text: root.cap-telemetry-hint;
                            color: Palette.text-faint;
                            font-size: 9px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ===== DEBUG PANEL =====
        if (root.debug-expanded): VerticalLayout {
            spacing: 8px;

            // ---- Debug Recording section ----
            Rectangle {
                height: 20px;
                Text {
                    text: root.cap-debug-header;
                    color: Palette.text-secondary;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            // record-video checkbox
            Rectangle {
                height: 18px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-width: 1px;
                        border-color: root.record-video ? Palette.accent : Palette.hairline-faint;
                        background: root.record-video ? Palette.accent-dim : transparent;
                        animate background, border-color { duration: 110ms; }
                        if (root.record-video): Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-x: 0;
                            viewbox-y: -960;
                            viewbox-width: 960;
                            viewbox-height: 960;
                            commands: Icons.check;
                            fill: Palette.text-primary;
                        }
                        rva := TouchArea {
                            clicked => { root.record-video = !root.record-video; }
                        }
                    }
                    Text {
                        text: root.cap-debug-video;
                        color: Palette.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // record-csv checkbox
            Rectangle {
                height: 18px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-width: 1px;
                        border-color: root.record-csv ? Palette.accent : Palette.hairline-faint;
                        background: root.record-csv ? Palette.accent-dim : transparent;
                        animate background, border-color { duration: 110ms; }
                        if (root.record-csv): Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-x: 0;
                            viewbox-y: -960;
                            viewbox-width: 960;
                            viewbox-height: 960;
                            commands: Icons.check;
                            fill: Palette.text-primary;
                        }
                        rca := TouchArea {
                            clicked => { root.record-csv = !root.record-csv; }
                        }
                    }
                    Text {
                        text: root.cap-debug-csv;
                        color: Palette.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // trace-logging checkbox
            Rectangle {
                height: 18px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-width: 1px;
                        border-color: root.trace-logging ? Palette.accent : Palette.hairline-faint;
                        background: root.trace-logging ? Palette.accent-dim : transparent;
                        animate background, border-color { duration: 110ms; }
                        if (root.trace-logging): Path {
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-x: 0;
                            viewbox-y: -960;
                            viewbox-width: 960;
                            viewbox-height: 960;
                            commands: Icons.check;
                            fill: Palette.text-primary;
                        }
                        tla := TouchArea {
                            clicked => { root.trace-logging = !root.trace-logging; }
                        }
                    }
                    Text {
                        text: root.cap-debug-trace;
                        color: Palette.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Manual target panel ----
            // Shown when the trailing "manual" row is selected. The target-type
            // control is a self-drawn dropdown: clicking it swaps the parameter
            // fields below for the list of types (in place — no floating popup,
            // matching the codebase's no-std-widgets self-rendered style and
            // keeping the layout height bounded).
            if (root.manual-selected): VerticalLayout {
                spacing: 6px;

                Text {
                    height: 18px;
                    text: root.cap-manual-header;
                    color: Palette.text-secondary;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // type dropdown — closed field
                Rectangle {
                    height: 24px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            width: 84px;
                            text: root.cap-manual-type;
                            color: Palette.text-faint;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-width: 1px;
                            border-color: root.manual-kind-open ? Palette.accent : Palette.hairline-faint;
                            background: #00000060;
                            height: 22px;
                            ddta := TouchArea {
                                clicked => { root.manual-kind-open = !root.manual-kind-open; }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 6px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.manual-type-label(root.manual-kind);
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Path {
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-x: 0;
                                    viewbox-y: -960;
                                    viewbox-width: 960;
                                    viewbox-height: 960;
                                    // Material Symbols "expand_more" (down chevron)
                                    commands: "M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z";
                                    fill: Palette.text-secondary;
                                }
                            }
                        }
                    }
                }

                // dropdown OPEN: the type options replace the parameter fields
                if (root.manual-kind-open): VerticalLayout {
                    spacing: 1px;
                    for label[i] in [
                        root.cap-manual-type-mumu,
                        root.cap-manual-type-ldplayer,
                        root.cap-manual-type-adb,
                        root.cap-manual-type-pc,
                        root.cap-manual-type-virtual,
                    ] : Rectangle {
                        height: 24px;
                        border-width: 1px;
                        border-color: root.manual-kind == i ? Palette.accent : Palette.hairline-faint;
                        background: root.manual-kind == i ? Palette.accent-dim
                            : (ota.has-hover ? Palette.hover-fill : transparent);
                        animate background { duration: 90ms; }
                        ota := TouchArea {
                            clicked => {
                                root.manual-kind = i;
                                root.manual-kind-open = false;
                            }
                        }
                        Text {
                            x: 10px;
                            text: label;
                            color: Palette.text-primary;
                            font-size: 12px;
                            font-weight: root.manual-kind == i ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }

                // dropdown CLOSED: parameter fields for the selected type
                if (!root.manual-kind-open): VerticalLayout {
                    spacing: 6px;

                    // MuMu / LDPlayer: install path
                    if (root.manual-kind == 0 || root.manual-kind == 1): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 84px;
                                text: root.cap-manual-install;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: #00000060;
                                height: 22px;
                                TextInput {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 100%;
                                    text <=> root.manual-install-path;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                            // browse for the emulator install folder
                            Rectangle {
                                width: 52px;
                                height: 22px;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: bia.has-hover ? Palette.hover-fill : transparent;
                                animate background { duration: 110ms; }
                                Text {
                                    text: root.cap-manual-browse;
                                    color: Palette.text-secondary;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                bia := TouchArea {
                                    clicked => { root.browse-install(); }
                                }
                            }
                        }
                    }
                    // MuMu / LDPlayer: instance index
                    if (root.manual-kind == 0 || root.manual-kind == 1): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 84px;
                                text: root.cap-manual-instance;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 60px;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: #00000060;
                                height: 22px;
                                TextInput {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 100%;
                                    text <=> root.manual-instance-index;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // MuMu / LDPlayer / Generic ADB: device serial
                    if (root.manual-kind == 0 || root.manual-kind == 1 || root.manual-kind == 2): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 84px;
                                text: root.cap-manual-serial;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: #00000060;
                                height: 22px;
                                TextInput {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 100%;
                                    text <=> root.manual-device-id;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // PC / Windows: window title
                    if (root.manual-kind == 3): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 84px;
                                text: root.cap-manual-window;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: #00000060;
                                height: 22px;
                                TextInput {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 100%;
                                    text <=> root.manual-window-title;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // Virtual / Replay: recorded video path
                    if (root.manual-kind == 4): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 84px;
                                text: root.cap-replay-path;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: #00000060;
                                height: 22px;
                                TextInput {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 100%;
                                    text <=> root.replay-path;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                            // browse for the recorded video file
                            Rectangle {
                                width: 52px;
                                height: 22px;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: bra.has-hover ? Palette.hover-fill : transparent;
                                animate background { duration: 110ms; }
                                Text {
                                    text: root.cap-manual-browse;
                                    color: Palette.text-secondary;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                bra := TouchArea {
                                    clicked => { root.browse-replay(); }
                                }
                            }
                        }
                    }
                    // Virtual / Replay: fallback fps
                    if (root.manual-kind == 4): Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                width: 84px;
                                text: root.cap-replay-fps-label;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 60px;
                                border-width: 1px;
                                border-color: Palette.hairline-faint;
                                background: #00000060;
                                height: 22px;
                                TextInput {
                                    x: 4px;
                                    width: parent.width - 8px;
                                    height: 100%;
                                    text <=> root.replay-fps-text;
                                    color: Palette.text-primary;
                                    font-size: 11px;
                                    single-line: true;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "fps";
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ===== status line =====
        Text {
            text: root.status-text;
            color: root.status-error ? Palette.danger : Palette.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            min-height: 28px;
            vertical-stretch: 1;
            vertical-alignment: top;
        }

        // ===== footer buttons =====
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            // show / hide debug options
            debug-btn := Rectangle {
                width: 144px;
                height: 30px;
                border-width: 1px;
                border-color: Palette.hairline-faint;
                background: dbga.has-hover ? Palette.hover-fill : transparent;
                animate background { duration: 110ms; }
                Text {
                    text: root.debug-expanded ? root.cap-debug-hide : root.cap-debug-show;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                dbga := TouchArea {
                    clicked => { root.debug-expanded = !root.debug-expanded; }
                }
            }

            // refresh
            ref-btn := Rectangle {
                width: 84px;
                height: 30px;
                border-width: 1px;
                border-color: Palette.hairline-faint;
                background: refa.has-hover ? Palette.hover-fill : transparent;
                animate background { duration: 110ms; }
                Text {
                    text: root.cap-refresh;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                refa := TouchArea { clicked => { root.refresh(); } }
            }
            // cancel
            cancel-btn := Rectangle {
                width: 84px;
                height: 30px;
                border-width: 1px;
                border-color: Palette.hairline-faint;
                background: cana.has-hover ? Palette.hover-fill : transparent;
                animate background { duration: 110ms; }
                Text {
                    text: root.cap-cancel;
                    color: Palette.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cana := TouchArea { clicked => { root.cancel(); } }
            }
            // save & start (primary)
            start-btn := Rectangle {
                width: 120px;
                height: 30px;
                border-width: 1px;
                border-color: Palette.accent;
                background: sta.has-hover ? Palette.accent.with-alpha(0.30) : Palette.accent-dim;
                animate background { duration: 110ms; }
                Text {
                    text: root.cap-start;
                    color: Palette.text-primary;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                sta := TouchArea { clicked => { root.confirm(); } }
            }
        }
    }
}
