// Arknights Cost Bar Ruler — HUD overlay
// Cold / sharp / minimal. Timer is the hero; cost frame is a quiet secondary cluster.
// Rendered by the software renderer into a per-pixel-alpha layered window.
// All user-facing strings are localized in Rust and pushed in as properties.

export enum HudMode {
    booting,
    idle,
    precal,
    calibrating,
    running,
    error,
}

// --- design tokens -------------------------------------------------------
global Palette {
    out property <color> panel: #0a0e12e0;          // near-black, ~88% opaque
    out property <color> hairline: #46c4ff8c;        // cyan hairline ~55%
    out property <color> accent: #36c5f0;            // running cyan
    out property <color> amber: #ffb020;             // warning / negative cost / lap
    out property <color> text-primary: #eef6fb;
    out property <color> text-secondary: #7d93a6;
    out property <color> text-faint: #54677a;
    out property <color> toolbar: #0d1117f5;
}

// Material-style outlined icon paths (24x24 viewbox, stroked).
global Icons {
    out property <string> prev: "M16 6 L8 12 L16 18 M7 6 L7 18";
    out property <string> next: "M8 6 L16 12 L8 18 M17 6 L17 18";
    out property <string> flag: "M7 4 L7 20 M7 5 L16 8 L7 11";
    out property <string> reset: "M5 12 A7 7 0 1 0 8.5 6 M8.5 6 L5 5.5 M8.5 6 L8 9.5";
}

// --- small icon control button (hover-revealed toolbar) ------------------
component CtrlBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> strong: false;
    callback clicked;
    width: 24px;
    height: 20px;
    background: ta.has-hover ? #ffffff26 : #ffffff00;
    animate background { duration: 110ms; }
    Path {
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.strong ? Palette.amber : (ta.has-hover ? Palette.text-primary : Palette.text-secondary);
        stroke-width: 2px;
        fill: transparent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Hud inherits Window {
    // ---- inputs (driven from Rust each tick) ----
    in property <HudMode> mode: HudMode.booting;
    in property <string> time-str: "00:00:00";
    in property <string> frame-str: "--";
    in property <string> total-str: "/--";
    in property <string> lap-str: "";
    in property <bool> cost-negative: false;
    in property <float> progress: 0;          // 0..100 during calibration
    in property <string> progress-str: "0%";
    in property <string> message: "";
    in property <bool> force-controls: false; // preview/debug only

    // ---- outputs ----
    callback start-clicked();
    callback reset-clicked();
    callback lap-clicked();
    callback back-cycle();
    callback fwd-cycle();
    callback bg-pressed();
    callback bg-released();

    background: transparent;
    default-font-family: "Bender";
    preferred-width: 210px;
    preferred-height: 56px;

    property <bool> running: root.mode == HudMode.running;
    property <bool> show-controls: (hover.has-hover || root.force-controls) && root.running;

    // ---- panel ----
    Rectangle {
        background: Palette.panel;
        border-width: 1px;
        border-color: root.mode == HudMode.error ? Palette.amber : Palette.hairline;
        animate border-color { duration: 200ms; }
    }

    // top accent hairline — state colored
    Rectangle {
        x: 0; y: 0;
        width: 100%;
        height: 2px;
        background: root.mode == HudMode.error ? Palette.amber
            : (root.running ? Palette.accent : Palette.text-faint);
        opacity: 0.9;
        animate background { duration: 200ms; }
    }

    // ===== RUNNING: timer hero + secondary cluster (packed left, no gap) =====
    running-layer := Rectangle {
        opacity: root.running ? 1 : 0;
        animate opacity { duration: 160ms; }
        visible: running-layer.opacity > 0.01;

        HorizontalLayout {
            padding-left: 13px;
            padding-right: 12px;
            spacing: 13px;
            alignment: start;

            // hero timer
            Text {
                text: root.time-str;
                color: Palette.text-primary;
                font-size: 30px;
                font-weight: 700;
                vertical-alignment: center;
            }

            // secondary cluster (cost frame + lap) — dims out while the
            // hover toolbar is shown so the two don't clash.
            VerticalLayout {
                alignment: center;
                spacing: 0px;
                opacity: root.show-controls ? 0 : 1;
                animate opacity { duration: 140ms; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 0px;
                    Text {
                        text: root.frame-str;
                        color: Palette.text-primary;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.total-str;
                        color: root.cost-negative ? Palette.amber : Palette.text-secondary;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: bottom;
                    }
                }
                Text {
                    visible: root.lap-str != "";
                    text: "+" + root.lap-str;
                    color: Palette.amber;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: left;
                }
            }
        }
    }

    // ===== CALIBRATING: thin progress line + percent =====
    cal-layer := Rectangle {
        opacity: root.mode == HudMode.calibrating ? 1 : 0;
        animate opacity { duration: 160ms; }
        visible: cal-layer.opacity > 0.01;

        Text {
            text: root.progress-str;
            color: Palette.accent;
            font-size: 20px;
            font-weight: 700;
            x: 13px;
            y: 0;
            height: 100%;
            vertical-alignment: center;
        }
        Rectangle {
            x: 0;
            y: parent.height - 3px;
            width: 100%;
            height: 3px;
            background: #ffffff10;
            Rectangle {
                x: 0; y: 0;
                height: 100%;
                width: parent.width * (root.progress / 100);
                background: Palette.accent;
                animate width { duration: 120ms; }
            }
        }
    }

    // ===== IDLE / PRECAL / ERROR / BOOTING: message =====
    msg-layer := Rectangle {
        opacity: (root.running || root.mode == HudMode.calibrating) ? 0 : 1;
        animate opacity { duration: 160ms; }
        visible: msg-layer.opacity > 0.01;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            text: root.message;
            color: root.mode == HudMode.error ? Palette.amber : Palette.text-secondary;
            font-size: 13px;
            font-weight: 500;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== background interaction (drag + CTA), control toolbar as child =====
    // As a TouchArea, hover-state propagates to children, so moving onto a
    // button keeps `hover.has-hover` true (no reveal/hide flicker).
    hover := TouchArea {
        clicked => {
            if (root.mode == HudMode.precal) {
                root.start-clicked();
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.bg-pressed();
            }
            if (ev.kind == PointerEventKind.up) {
                root.bg-released();
            }
        }

        // hover-revealed control toolbar (running only), solid background.
        Rectangle {
            width: 108px;
            height: 24px;
            x: parent.width - self.width - 4px;
            y: parent.height - self.height - 4px;
            background: Palette.toolbar;
            border-width: 1px;
            border-color: Palette.hairline;
            opacity: root.show-controls ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 140ms; }

            HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                alignment: center;
                CtrlBtn { icon: Icons.prev; clicked => { root.back-cycle(); } }
                CtrlBtn { icon: Icons.reset; clicked => { root.reset-clicked(); } }
                CtrlBtn { icon: Icons.flag; strong: root.lap-str != ""; clicked => { root.lap-clicked(); } }
                CtrlBtn { icon: Icons.next; clicked => { root.fwd-cycle(); } }
            }
        }
    }
}
