// Arknights Cost Bar Ruler — right-click menu (replaces the native TrackPopupMenu).
// A single flat panel rather than nested submenus: each profile row carries its
// own select / rename / delete affordances inline. Rendered by the software
// renderer into its own per-pixel-alpha layered popup window.
//
// IMPORTANT: the vertical metrics below (ROW / DIV / PAD_V) are mirrored by
// `menu_height()` in overlay.rs so the native window is sized to fit exactly.
// Keep them in sync.

import { Palette, Icons, IconBtn, Chip } from "theme.slint";

export struct ProfileRow {
    name: string,
    frames: string,
    active: bool,
}

export component RulerMenu inherits Window {
    // ---- inputs ----
    in property <[ProfileRow]> profiles;
    in property <int> display-mode;     // 0 = 0/n-1, 1 = 0/n, 2 = 1/n
    in property <int> scale-index;      // 0=75% 1=100% 2=125% 3=150%
    in property <bool> timer-enabled;   // an active profile exists
    in property <bool> undo-reset-enabled;
    // True while the worker is inside the calibration capture loop. The header
    // swaps its "New" button for a "Cancel" button and the profile list is
    // hidden, so the only calibration-relevant action is to abort the run.
    in property <bool> calibrating;
    in property <string> cap-calibration;
    in property <string> cap-calibrating;
    in property <string> cap-display;
    in property <string> cap-scale;
    in property <string> cap-timer;
    in property <string> cap-timer-edit-placeholder;
    in property <string> cap-cancel;
    in property <string> cap-delete;
    in property <string> label-new;
    in property <string> about-text;
    in property <bool> update-available: false;
    in property <string> update-text: "";

    // inline edit / delete state: index of the row in that mode, or -1 (none).
    // Driven from Slint clicks; overlay.rs reads/clears them while routing keys.
    in-out property <int> editing-index: -1;
    in-out property <int> deleting-index: -1;
    in-out property <bool> timer-editing: false;
    in-out property <bool> timer-edit-invalid: false;

    // ---- outputs ----
    callback new-profile();
    callback select-profile(int);
    callback commit-rename(int, string);
    callback confirm-delete(int);
    callback set-display(int);
    callback set-scale(int);
    callback timer-action(int);   // 0 back-cycle, 1 back-1s, 2 reset, 3 fwd-1s, 4 fwd-cycle, 5 undo-reset
    callback commit-timer-edit(string) -> bool;
    callback cancel-calibration();
    callback about();
    callback exit();

    background: transparent;
    default-font-family: "Bender";

    // shared row metric (logical px) — mirror in overlay.rs
    property <length> row-h: 30px;
    property <length> control-h: 22px;
    property <length> icon-glyph: 16px;
    property <length> cap-w: 58px;

    // ---- panel ----
    Rectangle {
        background: #0b1016f8;
        border-width: 1px;
        border-color: Palette.hairline;
    }
    Rectangle {
        x: 0; y: 0;
        width: 100%;
        height: 2px;
        background: Palette.accent;
        opacity: 0.9;
    }

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 9px;
        padding-right: 9px;
        spacing: 0px;

        // ===== calibration header: caption + (new-profile OR cancel) =====
        Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                Text {
                    text: root.calibrating ? root.cap-calibrating : root.cap-calibration;
                    color: Palette.text-faint;
                    font-size: 10px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // New-profile button — hidden while a calibration is running,
                // since starting a new one mid-run would race the worker.
                if (!root.calibrating): Rectangle {
                    width: 78px;
                    height: root.control-h;
                    border-width: 1px;
                    border-color: Palette.hairline-faint;
                    background: nta.has-hover ? Palette.hover-fill : transparent;
                    animate background { duration: 110ms; }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 5px;
                        alignment: center;
                        // Path wrapped in a stretching Rectangle: x/y centering is
                        // ignored on a direct layout child, so center it inside.
                        Rectangle {
                            width: root.icon-glyph;
                            Path {
                                width: root.icon-glyph;
                                height: root.icon-glyph;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-x: 0;
                                viewbox-y: -960;
                                viewbox-width: 960;
                                viewbox-height: 960;
                                commands: Icons.plus;
                                fill: Palette.accent;
                            }
                        }
                        Text {
                            text: root.label-new;
                            color: Palette.accent;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    nta := TouchArea {
                        clicked => { root.new-profile(); }
                    }
                }
                // Cancel-calibration button — shown only while calibrating.
                // Aborts the in-flight capture loop and returns to PreCalibration.
                if (root.calibrating): Rectangle {
                    width: 60px;
                    height: root.control-h;
                    border-width: 1px;
                    border-color: Palette.danger;
                    background: cal-ta.has-hover ? Palette.danger.with-alpha(0.24) : Palette.danger.with-alpha(0.12);
                    animate background { duration: 110ms; }
                    Text {
                        text: root.cap-cancel;
                        color: Palette.danger;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cal-ta := TouchArea {
                        clicked => { root.cancel-calibration(); }
                    }
                }
            }
        }

        // ===== profile rows: click body to select; inline rename / delete =====
        for profile[idx] in root.profiles: Rectangle {
            height: root.row-h;
            background: root.deleting-index == idx ? #ff6b5e1a
                : (pta.has-hover && !profile.active && root.editing-index != idx) ? #ffffff14
                : transparent;
            animate background { duration: 90ms; }

            // Row-body select. Disabled while this row is in an inline mode so the
            // edit field / confirm buttons receive the clicks instead.
            pta := TouchArea {
                enabled: root.editing-index != idx && root.deleting-index != idx;
                clicked => {
                    if (!profile.active) {
                        root.select-profile(idx);
                    }
                }
            }

            // ---- normal ----
            if (root.editing-index != idx && root.deleting-index != idx): HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 2px;
                spacing: 3px;
                Rectangle {
                    width: 12px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: profile.active ? Palette.accent : transparent;
                    }
                }
                Text {
                    text: profile.name;
                    color: Palette.text-primary;
                    font-size: 13px;
                    font-weight: profile.active ? 700 : 500;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: profile.frames;
                    color: Palette.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                IconBtn {
                    icon: Icons.pencil;
                    height: root.control-h;
                    glyph: root.icon-glyph;
                    clicked => {
                        root.deleting-index = -1;
                        root.editing-index = idx;
                    }
                }
                IconBtn {
                    icon: Icons.cross;
                    height: root.control-h;
                    glyph: root.icon-glyph;
                    danger: true;
                    clicked => {
                        root.editing-index = -1;
                        root.deleting-index = idx;
                    }
                }
            }

            // ---- inline rename ----
            if (root.editing-index == idx): HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 2px;
                spacing: 3px;
                Rectangle {
                    width: 12px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: Palette.accent;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: root.control-h;
                    border-width: 1px;
                    border-color: Palette.accent;
                    background: #ffffff10;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        edit := TextInput {
                            color: Palette.text-primary;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Palette.accent-dim;
                            selection-foreground-color: Palette.text-primary;
                            // Seed once (not a reactive binding, so typing is free),
                            // then focus + select so the user can replace immediately.
                            init => {
                                self.text = profile.name;
                                self.select-all();
                                self.focus();
                            }
                            accepted => {
                                if (self.text != "") {
                                    root.commit-rename(idx, self.text);
                                    root.editing-index = -1;
                                }
                            }
                        }
                    }
                }
                IconBtn {
                    icon: Icons.check;
                    height: root.control-h;
                    glyph: root.icon-glyph;
                    clicked => {
                        if (edit.text != "") {
                            root.commit-rename(idx, edit.text);
                            root.editing-index = -1;
                        }
                    }
                }
                IconBtn {
                    icon: Icons.cross;
                    height: root.control-h;
                    glyph: root.icon-glyph;
                    clicked => { root.editing-index = -1; }
                }
            }

            // ---- inline delete confirm ----
            if (root.deleting-index == idx): HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 2px;
                spacing: 4px;
                Rectangle {
                    width: 12px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: Palette.danger;
                    }
                }
                Text {
                    text: profile.name;
                    color: Palette.danger;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 50px;
                    height: root.control-h;
                    border-width: 1px;
                    border-color: Palette.hairline-faint;
                    background: cancel-ta.has-hover ? Palette.hover-fill : transparent;
                    animate background { duration: 110ms; }
                    Text {
                        text: root.cap-cancel;
                        color: Palette.text-secondary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cancel-ta := TouchArea {
                        clicked => { root.deleting-index = -1; }
                    }
                }
                Rectangle {
                    width: 50px;
                    height: root.control-h;
                    border-width: 1px;
                    border-color: Palette.danger;
                    background: del-ta.has-hover ? Palette.danger.with-alpha(0.24) : Palette.danger.with-alpha(0.12);
                    animate background { duration: 110ms; }
                    Text {
                        text: root.cap-delete;
                        color: Palette.danger;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    del-ta := TouchArea {
                        clicked => {
                            root.confirm-delete(idx);
                            root.deleting-index = -1;
                        }
                    }
                }
            }
        }

        // ===== divider =====
        Rectangle {
            height: 12px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 1px;
                background: Palette.hairline-faint;
            }
        }

        // ===== display mode =====
        Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                Text {
                    text: root.cap-display;
                    color: Palette.text-faint;
                    font-size: 10px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    width: root.cap-w;
                }
                HorizontalLayout {
                    spacing: 5px;
                    Chip {
                        height: root.control-h;
                        label: "0/n-1";
                        selected: root.display-mode == 0;
                        clicked => { root.set-display(0); }
                    }
                    Chip {
                        height: root.control-h;
                        label: "0/n";
                        selected: root.display-mode == 1;
                        clicked => { root.set-display(1); }
                    }
                    Chip {
                        height: root.control-h;
                        label: "1/n";
                        selected: root.display-mode == 2;
                        clicked => { root.set-display(2); }
                    }
                    Rectangle { }   // trailing spacer
                }
            }
        }

        // ===== scale =====
        Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                Text {
                    text: root.cap-scale;
                    color: Palette.text-faint;
                    font-size: 10px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    width: root.cap-w;
                }
                HorizontalLayout {
                    spacing: 5px;
                    Chip {
                        height: root.control-h;
                        label: "75%";
                        selected: root.scale-index == 0;
                        clicked => { root.set-scale(0); }
                    }
                    Chip {
                        height: root.control-h;
                        label: "100%";
                        selected: root.scale-index == 1;
                        clicked => { root.set-scale(1); }
                    }
                    Chip {
                        height: root.control-h;
                        label: "125%";
                        selected: root.scale-index == 2;
                        clicked => { root.set-scale(2); }
                    }
                    Chip {
                        height: root.control-h;
                        label: "150%";
                        selected: root.scale-index == 3;
                        clicked => { root.set-scale(3); }
                    }
                    Rectangle { }   // trailing spacer
                }
            }
        }

        // ===== timer adjust =====
        Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 6px;
                Text {
                    text: root.cap-timer;
                    color: Palette.text-faint;
                    font-size: 10px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    width: root.cap-w;
                }
                if (!root.timer-editing): HorizontalLayout {
                    spacing: 2px;
                    alignment: start;
                    IconBtn {
                        icon: Icons.prev;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.timer-enabled;
                        clicked => { root.timer-action(0); }
                    }
                    IconBtn {
                        icon: Icons.chev-left;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.timer-enabled;
                        clicked => { root.timer-action(1); }
                    }
                    IconBtn {
                        icon: Icons.undo-reset;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.undo-reset-enabled;
                        clicked => { root.timer-action(5); }
                    }
                    IconBtn {
                        icon: Icons.reset;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.timer-enabled;
                        clicked => { root.timer-action(2); }
                    }
                    IconBtn {
                        icon: Icons.pencil;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.timer-enabled;
                        clicked => {
                            root.editing-index = -1;
                            root.deleting-index = -1;
                            root.timer-edit-invalid = false;
                            root.timer-editing = true;
                        }
                    }
                    IconBtn {
                        icon: Icons.chev-right;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.timer-enabled;
                        clicked => { root.timer-action(3); }
                    }
                    IconBtn {
                        icon: Icons.next;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        enabled: root.timer-enabled;
                        clicked => { root.timer-action(4); }
                    }
                    Rectangle { }   // trailing spacer
                }
                if (root.timer-editing): HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: root.control-h;
                        border-width: 1px;
                        border-color: root.timer-edit-invalid ? Palette.danger : Palette.accent;
                        background: #ffffff10;
                        timer_edit := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: 100%;
                            color: Palette.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            selection-background-color: Palette.accent-dim;
                            selection-foreground-color: Palette.text-primary;
                            init => { self.focus(); }
                            edited => { root.timer-edit-invalid = false; }
                            accepted => {
                                if (root.commit-timer-edit(self.text)) {
                                    root.timer-edit-invalid = false;
                                    root.timer-editing = false;
                                } else {
                                    root.timer-edit-invalid = true;
                                    self.select-all();
                                    self.focus();
                                }
                            }
                        }
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: 100%;
                            text: root.cap-timer-edit-placeholder;
                            color: Palette.text-faint;
                            font-size: 11px;
                            vertical-alignment: center;
                            visible: timer_edit.text == "";
                        }
                    }
                    IconBtn {
                        icon: Icons.cross;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        clicked => {
                            root.timer-edit-invalid = false;
                            root.timer-editing = false;
                        }
                    }
                    IconBtn {
                        icon: Icons.check;
                        height: root.control-h;
                        glyph: root.icon-glyph;
                        clicked => {
                            if (root.commit-timer-edit(timer_edit.text)) {
                                root.timer-edit-invalid = false;
                                root.timer-editing = false;
                            } else {
                                root.timer-edit-invalid = true;
                                timer_edit.select-all();
                                timer_edit.focus();
                            }
                        }
                    }
                }
            }
        }

        // ===== divider =====
        Rectangle {
            height: 12px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 1px;
                background: Palette.hairline-faint;
            }
        }

        // ===== footer: about (left) + exit (right) =====
        Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 2px;
                about-btn := Rectangle {
                    horizontal-stretch: 1;
                    background: ata.has-hover ? Palette.hover-fill : transparent;
                    animate background { duration: 110ms; }
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 5px;
                        alignment: start;
                        Rectangle {
                            width: 14px;
                            Path {
                                width: 13px;
                                height: 13px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-x: 0;
                                viewbox-y: -960;
                                viewbox-width: 960;
                                viewbox-height: 960;
                                commands: Icons.info;
                                fill: Palette.text-secondary;
                            }
                        }
                        Text {
                            text: root.about-text;
                            color: Palette.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if (root.update-available): Rectangle {
                            width: 48px;
                            height: 18px;
                            border-width: 1px;
                            border-color: Palette.accent;
                            background: ata.has-hover ? Palette.accent.with-alpha(0.30) : Palette.accent-dim;
                            animate background { duration: 110ms; }
                            Text {
                                text: root.update-text;
                                color: Palette.text-primary;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    ata := TouchArea {
                        clicked => { root.about(); }
                    }
                }
                IconBtn {
                    icon: Icons.power;
                    height: root.control-h;
                    glyph: root.icon-glyph;
                    danger: true;
                    clicked => { root.exit(); }
                }
            }
        }
    }
}
